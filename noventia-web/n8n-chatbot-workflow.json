{
  "name": "Noventia — Chatbot web",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "noventia-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 0],
      "webhookId": "noventia-chat"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "=Eres el asistente virtual de Noventia (noventia.tech), una agencia que diseña automatizaciones con inteligencia artificial, chatbots y páginas web a medida para empresas de cualquier sector. Hoy es {{ $now.format('DDDD, d LLLL yyyy') }}.\n\nTu tono: cercano, directo, profesional, en español. Frases cortas. Nada de tecnicismos innecesarios.\n\nQué debes hacer:\n- Explicar qué hace Noventia: automatizaciones a medida (no plantillas), recepcionista IA 24/7, páginas web, chatbots.\n- Aclarar que la tecnología es una herramienta del equipo, no algo que sustituye a las personas.\n- Si preguntan por precio, plazos o quieren contratar: anímales a reservar una llamada gratuita (14 días de prueba) y a dejar su email o dar el enlace de contacto de la web.\n- Si preguntan algo que no sabes con certeza sobre la empresa, sé honesto y sugiere que lo hablen directamente en la llamada.\n- No inventes datos, precios ni plazos que no te hayan dado.\n- Respuestas breves (2-4 frases), sin markdown pesado ni listas largas salvo que ayude mucho.",
          "maxIterations": 10
        }
      },
      "id": "ai-agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "openai-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [-320, 220],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdExpression": "={{ $json.body.sessionId }}",
        "contextWindowLength": 50
      },
      "id": "chat-memory",
      "name": "Memoria de conversación",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [-120, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"reply\": $json.output } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type" }
            ]
          }
        }
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [20, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "AI Agent": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Memoria de conversación": {
      "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]]
    }
  }
}
